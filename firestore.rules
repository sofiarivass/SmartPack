rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate alphanumeric identifier
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Shipments collection rules
    match /shipments/{shipmentId} {
      allow read: if true;
      allow create, update: if isValidId(shipmentId)
        && request.resource.data.weight is number
        && request.resource.data.length is number
        && request.resource.data.width is number
        && request.resource.data.height is number;
      allow delete: if false;
    }

    // Default deny catch-all for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
